# Локальные дампы БД
.backups/
*.sql.gz
# ...кроме handoff-дампа: он и есть контент сайта (товары, категории,
# страницы). Синхронизируется между машинами через Git LFS.
!handoff/wordpress-db.sql.gz

# Секреты окружения (пример — .env.example)
.env

# Docker volumes
.docker/

# Прайсы поставщика «az» (140 MB): сырьё уже импортированного каталога,
# ни один скрипт репозитория их не читает, на чистом WP не нужны.
# Лежат локально; для кросс-филла по DATA-QUALITY-FIX брать с рабочей машины.
products-csv/new_products_from_az/az/

# Composer (регенерируется composer install). Якорь «/» обязателен:
# без него правило матчило и assets/js/vendor/ — self-hosted GSAP
# не попадал в git, и на свежем клоне разваливались скролл-секции главной.
/vendor/

# OS
.DS_Store
**/.DS_Store

# Рабочие базы SEO-краула (крупные, пересобираются)
perf-reports/seo/*.db
# Объёмные перечни аудита — пересобираются из базы командой report.py
perf-reports/seo/*/deep.csv
perf-reports/seo/*/long_desc.csv
perf-reports/seo/*/long_title.csv
perf-reports/seo/*/slow.csv

# Файлы полностраничного кеша (создаются на лету)
wp-content/cache/

# Скиллы higgsfield ставятся окружением, к проекту не относятся
.claude/skills/higgsfield-*/

# Промежуточные данные сборки карты редиректов (восстанавливаются скриптом)
migration/old-sitemap.xml
migration/new-catalog.tsv
migration/new-category-urls.txt
migration/unmatched-products.txt
migration/log-urls.txt
migration/log-missing.txt
migration/verify-report.txt

# Ролики оживающих портретов: 6,6 МБ бинарников, живут на проде и в рабочей
# копии, в репозиторий намеренно не едут (рядом лежат <img>.json с параметрами
# наезда — они версионируются). Забрать их с сервера: ssh promen-prod tar.
wp-content/themes/promen/assets/video/managers/*.mp4
wp-content/themes/promen/assets/video/managers/*.webm

# Байт-код Python: интерпретатор складывает сюда скомпилированные scripts/seo/*.py
# при импорте одного скрипта из другого. Файл привязан к версии интерпретатора
# (yandex.cpython-313.pyc), пересобирается сам, в репозитории не нужен.
__pycache__/
*.pyc
