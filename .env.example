PROMEN_MEILI_URL=http://meilisearch:7700
PROMEN_MEILI_KEY=promen_dev_key
# Калькулятор доставки (inc/delivery-calc.php). Без ключа сайт работает, но
# кнопка «Рассчитать доставку» на карточке товара тихо деградирует до обычной
# формы запроса — это единственный симптом, ошибок нигде не будет.
# Действующее значение — в site/.env (OneDrive синхронизирует его между
# машинами; в git не попадает). Первоисточник: письмо после регистрации
# приложения на dev.dellin.ru.
PROMEN_DELLIN_APPKEY=
